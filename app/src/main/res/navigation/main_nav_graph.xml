<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_navigation"
    app:startDestination="@+id/schedule">

    <fragment
        android:id="@+id/schedule"
        android:name="net.opensourcefreak.jklass.app.ui.mainfragments.CalendarFragment"/>
    <fragment
        android:id="@+id/feed"
        android:name="net.opensourcefreak.jklass.app.ui.mainfragments.FeedFragment"/>

    <navigation
        android:id="@+id/more"
        app:startDestination="@id/more_fragment">
        <fragment
            android:id="@+id/more_fragment"
            android:name="net.opensourcefreak.jklass.app.ui.mainfragments.MoreFragment">
            <action
                android:id="@+id/action_open_menu"
                app:destination="@id/menu"
                app:enterAnim="@animator/nav_default_enter_anim"
                app:exitAnim="@animator/nav_default_exit_anim"
                app:popEnterAnim="@animator/nav_default_pop_enter_anim"
                app:popExitAnim="@animator/nav_default_pop_exit_anim"/>
        </fragment>

        <fragment
            android:id="@+id/menu"
            android:name="net.opensourcefreak.jklass.app.ui.mainfragments.MenuFragment"/>
    </navigation>
</navigation>